# SMTP Configuration for Website Contact Form Delivery (Nodemailer)
# Add these environment variables in your Vercel Project Settings -> Environment Variables.
#
# Common Provider Options:
#
# Option A: Google Workspace / Gmail (Recommended if using Workspace)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@algorithec.com
# SMTP_PASS=your-16-char-google-app-password
# SMTP_FROM="ALGORITHEC" <info@algorithec.com>
#
# Option B: Brevo / Sendinblue (Recommended for transactional delivery)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-brevo-smtp-login
# SMTP_PASS=your-brevo-smtp-key
# SMTP_FROM="ALGORITHEC" <info@algorithec.com>
#
# Option C: AWS SES / Zoho / Custom SMTP
# SMTP_HOST=your-smtp-server.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM="ALGORITHEC" <info@algorithec.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ALGORITHEC" <info@algorithec.com>
